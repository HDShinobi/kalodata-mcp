# Required: your Kalodata Open API key (never commit the real value)
KALODATA_SECRET_KEY=your_key_here
# Use the host from your Kalodata activation email for production keys
KALODATA_BASE_URL=https://staging.kalodata.com
KALODATA_TIMEOUT=30

# Defaults used when a tool call omits these parameters (e.g. VN / vi-VN / VND)
KALODATA_DEFAULT_REGION=US
KALODATA_DEFAULT_LANGUAGE=en-US
KALODATA_DEFAULT_CURRENCY=USD
KALODATA_DEFAULT_DATE_RANGE=last7Day

# Server
MCP_TRANSPORT=streamable-http
MCP_AUTH_TOKEN=
MCP_STATELESS_HTTP=true
PORT=8000
HOST=0.0.0.0
